# ===== AMBIENTE =====
EFI_ENV=production

# ===== BANCO DE DADOS =====
DB_HOST=promestre.mysql.dbaas.com.br
DB_NAME=promestre
DB_USER=promestre
DB_PASS=Promestre#2026

# ===== SITE =====
SITE_NAME=Promestre
SITE_URL=https://promestre.pageup.net.br

# ===== OBRIGATÓRIO (SaaS do sistema / Assinaturas e Links de Cartão - API Cobranças) =====
EFI_CHARGES_CLIENT_ID=seu_client_id_aqui
EFI_CHARGES_CLIENT_SECRET=seu_client_secret_aqui

# ===== OBRIGATÓRIO (Webhooks) =====
# Em produção, use URL pública HTTPS (não pode ser localhost).
EFI_WEBHOOK_URL=https://seudominio.com/promestre/webhook_efiassinaturas.php
EFI_WEBHOOK_SECRET=sua_chave_webhook_aqui

# ===== OBRIGATÓRIO (SaaS - valores) =====
PROMESTRE_SAAS_VALOR_MENSAL=49.90
PROMESTRE_SAAS_VALOR_MIN=2.00

# ===== OPCIONAL (PIX/BOLETO - se quiser um "padrão global") =====
# OBS: no Promestre, o PIX/BOLETO dos alunos é por PROFESSOR (configurado no Perfil do professor).
# Estes campos podem ser usados como referência/padrão, mas não substituem a configuração por professor.
EFI_PIX_CLIENT_ID=seu_pix_client_id_aqui
EFI_PIX_CLIENT_SECRET=seu_pix_client_secret_aqui
EFI_CERT_PATH=./producao-573055-promestre.p12
EFI_CERT_PASSWORD=senha_do_certificado

# ===== OPCIONAL (PIX) =====
EFI_PIX_KEY=sua_chave_pix_aqui
EFI_PIX_DESCRIPTION=Pagamento de mensalidade
EFI_PIX_NOTIFICATION_URL=https://seudominio.com/promestre/webhook_efibank.php

# ===== EMAIL (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app_aqui
EMAIL_FROM=seuemail@gmail.com
EMAIL_FROM_NAME=Promestre

# ===== PARA CRIAR CHAVE DE WEBHOOK =====
# No Windows PowerShell: [guid]::NewGuid().ToString("N")
# Resultado exemplo: e239541a10244d1b9c5bb4b14bab7e83
TEMP_WEBHOOK_TOKEN=
